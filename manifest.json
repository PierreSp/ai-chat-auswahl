{
  "manifest_version": 3,
  "name": "AI Chat-Auswahl",
  "version": "1.2.9",
  "description": "Chats in ChatGPT, Claude und Gemini per Checkbox auswählen, prüfen und gemeinsam löschen. Lokal, ohne Tracking.",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "providers.js",
        "core.js",
        "diagnostics.js",
        "ui-style.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "AI Chat-Auswahl",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
